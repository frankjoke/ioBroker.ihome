{
  "name": "iobroker.ihome",
  "version": "0.1.1",
  "description": "iHome — dashboard adapter for ioBroker home automation (Svelte SPA + PWA)",
  "author": {
    "name": "Frank Joke",
    "email": "frankjoke@hotmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/frankjoke/ioBroker.ihome",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "ihome",
    "dashboard",
    "home automation",
    "SPA",
    "PWA",
    "Svelte"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/frankjoke/ioBroker.ihome.git"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@eslint/eslintrc": "^2.1.4",
    "@eslint/js": "^8.57.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.2",
    "@iobroker/ws": "^3.1.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^15.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.55.3",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.8.1",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.0"
  },
  "main": "main.js",
  "files": [
    "admin/",
    "www/",
    "io-package.json",
    "LICENSE",
    "README.md",
    "main.js"
  ],
  "scripts": {
    "dev": "vite dev --open",
    "build": "vite build",
    "pack": "npm run build && npm pack",
    "deploy:www": "node scripts/deploy-www.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:package && npm run test:integration",
    "test:unit": "vitest run",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/frankjoke/ioBroker.ihome/issues"
  },
  "readmeFilename": "README.md"
}
