  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js",
    "vite.config.mts"
  ],
  "scripts": {
    "dev": "vite dev --open",
    "build": "vite build",
