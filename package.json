    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.55.3",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.8.1",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.0"
