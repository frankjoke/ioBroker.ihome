{
  "type": "tabs",
  "i18n": false,
  "items": {
    "push": {
      "type": "panel",
      "label": "Push notifications",
      "items": {
        "vapidPublicKey": {
          "type": "text",
          "label": "VAPID public key",
          "help": "Run `npm run vapid` in the adapter directory and paste the publicKey here.",
          "sm": 12,
          "md": 6,
          "lg": 6
        },
        "vapidPrivateKey": {
          "type": "password",
          "label": "VAPID private key",
          "help": "Paste the privateKey from `npm run vapid`. ioBroker stores it encrypted. If the field shows garbage, clear it and paste the key again.",
          "sm": 12,
          "md": 6,
          "lg": 6
        }
      }
    },
    "network": {
      "type": "panel",
      "label": "Network devices",
      "items": {
        "networkDevices": {
          "type": "table",
          "label": "Devices",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "items": [
            {
              "type": "text",
              "attr": "id",
              "title": "ID",
              "width": 110,
              "default": ""
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": 130,
              "default": ""
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP / host",
              "width": 150,
              "default": ""
            },
            {
              "type": "text",
              "attr": "mac",
              "title": "MAC (optional)",
              "width": 150,
              "default": ""
            },
            {
              "type": "number",
              "attr": "interval",
              "title": "Every (s)",
              "width": 90,
              "default": 60,
              "min": 10,
              "max": 3600
            },
            {
              "type": "number",
              "attr": "timeout",
              "title": "Timeout (s)",
              "width": 90,
              "default": 2,
              "min": 1,
              "max": 30
            },
            {
              "type": "number",
              "attr": "port",
              "title": "TCP port (0 = ping)",
              "width": 130,
              "default": 0,
              "min": 0,
              "max": 65535
            }
          ]
        }
      }
    },
    "pluginSettings": {
      "type": "panel",
      "label": "Plugins",
      "items": {
        "plugins": {
          "type": "table",
          "label": "Adapter plugins",
          "help": "Built-ins ignore Code. User plugins are trusted Node code. Saving restarts the adapter. The SPA cannot edit this list.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "uniqueColumns": ["id"],
          "items": [
            {
              "type": "text",
              "attr": "id",
              "title": "ID",
              "width": 130,
              "default": ""
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": 150,
              "default": ""
            },
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Enabled",
              "width": 80,
              "default": true
            },
            {
              "type": "checkbox",
              "attr": "builtin",
              "title": "Built-in",
              "width": 80,
              "default": false
            },
            {
              "type": "number",
              "attr": "timeoutMs",
              "title": "Timeout (ms)",
              "width": 110,
              "default": 5000,
              "min": 100,
              "max": 30000
            },
            {
              "type": "text",
              "attr": "code",
              "title": "Code",
              "width": 420,
              "minRows": 8,
              "maxRows": 20,
              "default": ""
            }
          ]
        }
      }
    }
  }
}
